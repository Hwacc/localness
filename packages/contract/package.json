{
  "name": "@localness/contract",
  "version": "0.1.0",
  "description": "Response contracts of the Localness public /api/v1: zod schemas and the types inferred from them.",
  "license": "Elastic-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hwacc/localness.git",
    "directory": "packages/contract"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./rules": {
      "types": "./dist/rules.d.mts",
      "default": "./dist/rules.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/spark-md5": "^3.0.5",
    "spark-md5": "^3.0.2",
    "tsdown": "^0.23.2",
    "typescript": "^5.9.3",
    "zod": "^4.5.4"
  }
}
