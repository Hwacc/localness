generator client {
  provider     = "prisma-client"
  output       = "client"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             Int              @id @default(autoincrement())
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  username       String           @unique
  nickname       String?
  email          String?
  password       String
  role           String           @default("USER")
  avatar         String?
  passwordSetAt  DateTime?        @map("password_set_at")
  teams          UserTeam[]
  translationLog TranslationLog[]
  tagLogs        TagLog[]
  pageLogs       PageLog[]
  projectLogs    ProjectLog[]
  gitSyncLogs    GitSyncLog[]
  inviteCodes    TeamInviteCode[]
  notifications  Notification[]
  authIdentities AuthIdentity[]
  projectOwners  ProjectOwner[]
  apiTokens      ApiToken[]
  projectSkills  ProjectSkill[]

  @@unique([username, id])
}

model AuthIdentity {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  provider          String
  providerAccountId String   @map("provider_account_id")
  displayName       String?  @map("display_name")
  email             String?
  userId            Int      @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  userId    Int       @map("user_id")
  type      String
  title     String
  body      String    @default("")
  payload   Json
  readAt    DateTime? @map("read_at")
  actedAt   DateTime? @map("acted_at")
  action    String    @default("none")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action])
  @@index([userId, createdAt])
}

model Team {
  id          Int              @id @default(autoincrement())
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  name        String
  members     UserTeam[]
  projects    Project[]
  inviteCodes TeamInviteCode[]
}

model TeamInviteCode {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  teamId    Int       @map("team_id")
  code      String    @unique
  role      String    @default("MEMBER")
  maxUses   Int?      @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  createdBy Int       @map("created_by")
  revokedAt DateTime? @map("revoked_at")
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([teamId, revokedAt])
}

model UserTeam {
  userId Int    @map("user_id")
  teamId Int    @map("team_id")
  role   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId])
}

model Project {
  id          Int              @id @default(autoincrement())
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  name        String
  description String?
  teamId      Int              @map("team_id")
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pages       Page[]
  settings    ProjectSettings?
  gitSync     GitSyncBinding?
  projectLogs ProjectLog[]
  i18nKeys    I18nKey[]
  gitSyncBases GitSyncBase[]
  gitSyncConflicts GitSyncConflict[]
  gitSyncPreviews  GitSyncPreview[]
  gitSyncLogs      GitSyncLog[]
  owners           ProjectOwner[]
  releases         ProjectRelease[]
  apiTokens        ApiToken[]
  skills           ProjectSkill[]

  @@index([teamId])
}

/// A release label on a Project. Filters Pages and I18nKeys into "what shipped
/// in this version" — it is not a copy of the copy, a Git boundary, or a
/// publish unit: one key still has one set of texts.
model ProjectRelease {
  id        Int              @id @default(autoincrement())
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  projectId Int              @map("project_id")
  name      String
  /// Explicit order, so a later drag-to-reorder only has to move values.
  sort      Int              @default(0)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages     PageRelease[]
  i18nKeys  I18nKeyRelease[]

  @@unique([projectId, name])
  @@index([projectId])
}

model PageRelease {
  pageId    Int            @map("page_id")
  releaseId Int            @map("release_id")
  page      Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  release   ProjectRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@id([pageId, releaseId])
  @@index([releaseId])
}

model I18nKeyRelease {
  i18nKeyId Int            @map("i18n_key_id")
  releaseId Int            @map("release_id")
  i18nKey   I18nKey        @relation(fields: [i18nKeyId], references: [id], onDelete: Cascade)
  release   ProjectRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@id([i18nKeyId, releaseId])
  @@index([releaseId])
}

model ProjectOwner {
  userId    Int     @map("user_id")
  projectId Int     @map("project_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

/// A read-only API credential for one Project. The presented token is never
/// stored: `token_hash` is its deterministic sha256, which is what lets the
/// auth path find the row with one indexed lookup instead of scanning and
/// comparing every token. `prefix` exists only so the UI can tell two tokens
/// apart after the plaintext is gone. Revoking is the only way a token stops
/// working — there is no expiry, because nothing in the product sets one.
model ApiToken {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  projectId  Int       @map("project_id")
  createdBy  Int       @map("created_by")
  name       String
  tokenHash  String    @unique @map("token_hash")
  prefix     String
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdBy])
}

/// A Skill package shared inside one Project. The blob lives in OSS; this row
/// is the catalog (name, description, who to ask). Not an MCP tool and not a
/// git remote — members download the zip and drop it into their agent skills dir.
model ProjectSkill {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  projectId    Int      @map("project_id")
  createdBy    Int      @map("created_by")
  name         String
  description  String
  storageKey   String   @map("storage_key")
  originalName String   @map("original_name")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@index([createdBy])
}

model ProjectSettings {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  projectID      Int      @unique @map("project_id")
  ocrLanguage    String   @map("ocr_language")
  ocrEngine      Int      @map("ocr_engine")
  prompt         String?  @default("")
  locales        Json     @default("[\"en\",\"zh_cn\",\"zh_tw\",\"ja\",\"ko\",\"ru\",\"fr\",\"de\",\"es\",\"pt\"]")
  localeFallback String   @default("en") @map("locale_fallback")
  // Naming convention for i18n keys. The prefix default is empty on purpose:
  // a non-empty default would flag every existing key as non-compliant. New
  // projects are seeded from a slug of the project name instead.
  keyPrefix      String   @default("") @map("key_prefix")
  keySeparator   String   @default("_") @map("key_separator")
  keyStyle       String   @default("snake_case") @map("key_style")
  keyMaxDepth    Int      @default(4) @map("key_max_depth")
  project        Project  @relation(fields: [projectID], references: [id], onDelete: Cascade)
}

model ProjectLog {
  id         Int      @id @default(autoincrement())
  action     String
  status     String
  createdAt  DateTime @default(now()) @map("created_at")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  projectID  Int?     @map("project_id")
  userID     Int?     @map("user_id")
  project    Project? @relation(fields: [projectID], references: [id], onDelete: NoAction)
  user       User?    @relation(fields: [userID], references: [id], onDelete: SetNull)

  @@index([userID])
  @@index([createdAt])
}

model GitSyncBinding {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  projectId       Int      @unique @map("project_id")
  enabled         Boolean  @default(true)
  adapter         String   @default("lilt-swbu")
  remoteUrl       String   @default("") @map("remote_url")
  branch          String   @default("main")
  product         String
  credentialKind  String   @map("credential_kind")
  token           String   @default("")
  localeMap       Json?    @map("locale_map")
  seenFiles       Json?    @map("seen_files")
  lastPulledAt    DateTime? @map("last_pulled_at")
  lastPushedAt    DateTime? @map("last_pushed_at")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([adapter, remoteUrl, product])
}

model GitSyncBase {
  id        Int      @id @default(autoincrement())
  updatedAt DateTime @updatedAt @map("updated_at")
  projectId Int      @map("project_id")
  key       String
  locale    String
  baseText  String   @map("base_text")
  commitSha String   @default("") @map("commit_sha")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key, locale])
  @@index([projectId])
}

/// A dry-run snapshot awaiting human confirmation, then kept as an audit row.
model GitSyncPreview {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  projectId  Int      @map("project_id")
  kind       String
  status     String   @default("pending")
  commitSha  String   @default("") @map("commit_sha")
  candidates Json
  result     Json?
  createdBy  String   @default("") @map("created_by")
  expiresAt  DateTime @map("expires_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, status])
}

/// Append-only record of what a sync run actually did. Summaries only —
/// translation text stays in the translation tables.
model GitSyncLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  projectId Int      @map("project_id")
  action    String
  status    String
  previewId Int?     @map("preview_id")
  commitSha String   @default("") @map("commit_sha")
  detail    Json?
  userID    Int?     @map("user_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userID], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userID])
}

model GitSyncConflict {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  projectId     Int      @map("project_id")
  key           String
  locale        String
  baseText      String   @default("") @map("base_text")
  oursText      String   @map("ours_text")
  theirsText    String   @map("theirs_text")
  publishedText String?  @map("published_text")
  mergedText    String?  @map("merged_text")
  status        String   @default("open")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key, locale])
  @@index([projectId, status])
}

model Page {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  name      String
  image     String?
  projectID Int?          @map("project_id")
  project   Project?      @relation(fields: [projectID], references: [id], onDelete: Cascade)
  settings  PageSettings?
  tags      Tag[]
  pageLogs  PageLog[]
  releases  PageRelease[]
}

model PageSettings {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  pageID      Int      @unique @map("page_id")
  ocrLanguage String   @map("ocr_language")
  ocrEngine   Int      @map("ocr_engine")
  prompt      String?  @default("")
  // Nullable and default-free on purpose: a page *inherits* the project's key
  // convention until it is set, and no value can mean that — an empty prefix is
  // a real choice ("no prefix"), so `''` is taken. The four are written together
  // or left alone; a null here means "ask the project".
  keyPrefix    String? @map("key_prefix")
  keySeparator String? @map("key_separator")
  keyStyle     String? @map("key_style")
  keyMaxDepth  Int?    @map("key_max_depth")
  page         Page    @relation(fields: [pageID], references: [id], onDelete: Cascade)
}

model PageLog {
  id         Int      @id @default(autoincrement())
  action     String
  status     String
  createdAt  DateTime @default(now()) @map("created_at")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  pageID     Int?     @map("page_id")
  userID     Int?     @map("user_id")
  page       Page?    @relation(fields: [pageID], references: [id], onDelete: NoAction)
  user       User?    @relation(fields: [userID], references: [id], onDelete: SetNull)

  @@index([userID])
  @@index([createdAt])
}

model Tag {
  id            Int          @id @default(autoincrement())
  tagID         String       @map("tag_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  x             Float
  y             Float
  width         Float
  height        Float
  className     String       @map("class_name")
  pageID        Int          @map("page_id")
  i18nKeyId     Int?         @map("i18n_key_id")
  i18nKey       String?      @map("i18n_key")
  page          Page         @relation(fields: [pageID], references: [id], onDelete: Cascade)
  i18nKeyRecord I18nKey?     @relation(fields: [i18nKeyId], references: [id], onDelete: SetNull)
  settings      TagSettings?
  tagLogs       TagLog[]
}

model TagSettings {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  tagID      Int      @unique @map("tag_id")
  locked     Boolean  @default(false)
  style      Json
  labelStyle Json     @map("label_style")
  prompt     String?  @default("")
  tag        Tag      @relation(fields: [tagID], references: [id], onDelete: Cascade)
}

model TagLog {
  id         Int      @id @default(autoincrement())
  action     String
  status     String
  createdAt  DateTime @default(now()) @map("created_at")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  tagID      Int?     @map("tag_id")
  userID     Int?     @map("user_id")
  tag        Tag?     @relation(fields: [tagID], references: [id], onDelete: NoAction)
  user       User?    @relation(fields: [userID], references: [id], onDelete: SetNull)

  @@index([userID])
  @@index([createdAt])
}

model I18nKey {
  id           Int            @id @default(autoincrement())
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  projectId    Int            @map("project_id")
  key          String
  type         String         @default("STRING")
  origin       String         @default("")
  fingerprint  String         @default("")
  description  String?
  /// False keeps the key out of Git sync in both directions. Separate from
  /// `publishedText`, which decides whether the key is served at all.
  gitSyncEnabled Boolean      @default(true) @map("git_sync_enabled")
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locales      LocaleValue[]
  tags         Tag[]
  logs         TranslationLog[]
  releases     I18nKeyRelease[]

  @@unique([projectId, key])
  @@index([fingerprint])
}

model LocaleValue {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  i18nKeyId      Int      @map("i18n_key_id")
  locale         String
  draftText      String?  @map("draft_text")
  publishedText  String?  @map("published_text")
  i18nKey        I18nKey  @relation(fields: [i18nKeyId], references: [id], onDelete: Cascade)

  @@unique([i18nKeyId, locale])
}

model I18nMigrateConflict {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  projectId Int      @map("project_id")
  key       String
  locale    String
  vueText   String?  @map("vue_text")
  reactText String?  @map("react_text")
  tagIds    String   @map("tag_ids")
}

model TranslationLog {
  id            Int      @id @default(autoincrement())
  action        String
  status        String
  createdAt     DateTime @default(now()) @map("created_at")
  userID        Int?     @map("user_id")
  i18nKeyId     Int?     @map("i18n_key_id")
  fingerprint   String?
  beforeData    Json?    @map("before_data")
  afterData     Json?    @map("after_data")
  i18nKey       I18nKey? @relation(fields: [i18nKeyId], references: [id], onDelete: NoAction)
  user          User?    @relation(fields: [userID], references: [id], onDelete: SetNull)

  @@index([userID])
  @@index([createdAt])
}
