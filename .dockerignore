# Host artefacts must never reach the build context: node_modules holds
# Windows-built native bindings (better-sqlite3) and runtime/ holds live data.
node_modules
**/node_modules
.nuxt
.output
runtime
logs
.git
.gitignore
.vscode
.idea
.claude

# Secrets stay out of the image; inject them as container env instead.
.env
.env.*

# Not needed to build or run the server.
test
*.log
coverage
docker-compose.yml
Dockerfile
.dockerignore
README.md
CLAUDE.md
