{
  // Tests import server code, so they are checked with the server's Nitro
  // context and settings: auto-imports (createError, shared types) and the h3
  // path alias. `include` replaces the base's, so its Nitro type files are
  // listed again.
  "extends": "./.nuxt/tsconfig.server.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    ".nuxt/types/nitro-nuxt.d.ts",
    ".nuxt/types/nitro.d.ts",
    "server/**/*",
    "shared/**/*.d.ts",
    "test/unit/**/*.ts"
  ]
}