# Copy to .env.docker and fill in. Never commit the filled file.
# Anything not listed here has a working default inside the image.

# --- required ---
# 32+ characters. Sessions break without it; changing it logs everyone out.
NUXT_SESSION_PASSWORD=

# --- optional, defaults are set in the image ---
# Both point inside the mounted volume; only change them together with the mount.
# DATABASE_URL=file:/app/runtime/db/localness.db
# NUXT_LOCAL_OSS_DIR=/app/runtime/uploads

# Baked in at build time as well (see the Dockerfile arg). Keep both in sync and
# do not change it after go-live: existing password hashes depend on it.
NUXT_SALT_SIZE=10

# --- storage: LOCAL keeps uploads in the volume ---
# Files are served at GET /upload/:filename (session required). An empty
# base URL makes the browser request /{uuid}.png and 404.
NUXT_PUBLIC_OSS_ENGINE=LOCAL
NUXT_PUBLIC_OSS_BASE_URL=/upload/

# --- storage: QINIU only ---
# NUXT_PUBLIC_OSS_DOMAIN=
# NUXT_OSS_ACCESS_KEY=
# NUXT_OSS_SCRERT_KEY=

# --- OCR (Editor) ---
# NUXT_OCR_SPACE_KEY=
# NUXT_PUBLIC_OCR_SPACE_DOMAIN=

# --- Atlassian OAuth (optional) ---
# All unset = username/password login only. See docker/README.md.
# 3LO app from developer.atlassian.com, scope read:me. The callback registered
# there must equal REDIRECT_URL exactly: <your-origin>/auth/atlassian
# NUXT_OAUTH_ATLASSIAN_CLIENT_ID=
# NUXT_OAUTH_ATLASSIAN_CLIENT_SECRET=
# NUXT_OAUTH_ATLASSIAN_REDIRECT_URL=
# Comma-separated email domains allowed to JIT-sign-in / bind, no `@`.
# Empty DENIES everyone while the login button still shows — set it or the
# button always fails with ?oauth_error=domain.
# NUXT_ATLASSIAN_ALLOWED_EMAIL_DOMAINS=

# Host port is docker-compose.yml (default 13000), not this file.
# Override: LOCALNESS_PORT=14000 docker compose up -d
