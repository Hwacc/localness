# Copy to .env.docker and fill in. Never commit the filled file.
# Anything not listed here has a working default inside the image.

# --- required ---
# 32+ characters. Sessions break without it; changing it logs everyone out.
NUXT_SESSION_PASSWORD=

# --- optional, defaults are set in the image ---
# Both point inside the mounted volume; only change them together with the mount.
# DATABASE_URL=file:/app/runtime/db/localness.db
# NUXT_LOCAL_OSS_DIR=/app/runtime/uploads

# AI prompt files. The image ships defaults here; mount a directory over it to
# replace them. The mount must be readable by uid 1000 (the image's `node`).
# NUXT_PROMPTS_DIR=/app/prompts

# Baked in at build time as well (see the Dockerfile arg). Keep both in sync and
# do not change it after go-live: existing password hashes depend on it.
NUXT_SALT_SIZE=10

# --- storage: LOCAL keeps uploads in the volume ---
# Files are served at GET /upload/:filename (session required). An empty
# base URL makes the browser request /{uuid}.png and 404.
NUXT_PUBLIC_OSS_ENGINE=LOCAL
NUXT_PUBLIC_OSS_BASE_URL=/upload/

# --- storage: QINIU only ---
NUXT_PUBLIC_OSS_DOMAIN=
NUXT_OSS_ACCESS_KEY=
NUXT_OSS_SCRERT_KEY=

# --- OCR (Editor) ---
NUXT_OCR_SPACE_KEY=
NUXT_PUBLIC_OCR_SPACE_DOMAIN=

# --- AI: i18n key generation (Editor tag info dialog) ---
# Any OpenAI-compatible endpoint works; the defaults point at SiliconFlow.
# These three are the fallback every AI feature shares.
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
NUXT_OPENAI_MODEL=Qwen/Qwen3.5-4B

# Per-feature overrides, each falling back on its own to the value above. Set
# them when one feature needs a different provider, key or model — a cheap
# model for naming keys, say. The suffix is the feature slug in upper snake
# case: "i18n-key" -> I18N_KEY.
# NUXT_OPENAI_I18N_KEY_API_KEY=
# NUXT_OPENAI_I18N_KEY_BASE_URL=
# NUXT_OPENAI_I18N_KEY_MODEL=

# Log the prompts, the model's reasoning chain and its raw answer. Off by
# default: those carry the project's own UI text. The one-line summary (model,
# knobs, latency, thinking vs answer) is always logged.
# NUXT_AI_DEBUG=

# Host port and image pin are docker-compose.yml interpolation (shell or a
# project `.env`), not this file. This file is env_file for the container.
# Override: LOCALNESS_PORT=14000 docker compose up -d
# Pin: LOCALNESS_IMAGE=huacc/localness:1.2.0 docker compose up -d

# --- Atlassian OAuth (optional) ---
# 3LO app from developer.atlassian.com. Callback: <your-origin>/auth/atlassian
NUXT_OAUTH_ATLASSIAN_CLIENT_ID=
NUXT_OAUTH_ATLASSIAN_CLIENT_SECRET=
NUXT_OAUTH_ATLASSIAN_REDIRECT_URL=
# Comma-separated email domains allowed to JIT-sign-in / bind. Leave empty to deny all.
NUXT_ATLASSIAN_ALLOWED_EMAIL_DOMAINS=
